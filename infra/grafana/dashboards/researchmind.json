{
  "uid": "researchmind-overview",
  "title": "ResearchMind AI — Overview",
  "tags": ["researchmind"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_http_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(researchmind_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx share"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Indexed chunks (sparse)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "researchmind_indexed_chunks", "legendFormat": "chunks" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens / min",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_llm_tokens_total[5m])) * 60",
          "legendFormat": "tokens/min"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP latency by route (p50 / p95 / p99)",
      "description": "Quantiles are computed from the histogram rather than averaged, because an average latency hides exactly the tail that users notice.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(researchmind_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(researchmind_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(researchmind_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retrieval latency by stage (p95)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(researchmind_retrieval_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM calls by provider and outcome",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_llm_requests_total[5m])) by (provider, outcome)",
          "legendFormat": "{{provider}} · {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Token consumption by direction",
      "description": "Prompt and completion tokens are priced differently, so a cost dashboard that sums them cannot explain a bill.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_llm_tokens_total[5m])) by (direction)",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Agent runs by outcome",
      "description": "A rising error share here usually means one agent is degrading while the graph still returns an answer.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_agent_runs_total[5m])) by (agent, outcome)",
          "legendFormat": "{{agent}} · {{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingestion outcomes",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(researchmind_ingestion_total[15m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
