# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Auth ---
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Postgres ---
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=researchmind
POSTGRES_DB=researchmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://researchmind:researchmind@localhost:5432/researchmind

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Vector stores (used from Milestone 12 onward) ---
VECTOR_STORE_BACKEND=faiss
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Knowledge graph (used from Milestone 26 onward) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- LLM providers (used from Milestone 17 onward) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=openai

# --- Embeddings ---
EMBEDDING_PROVIDER=openai
JINA_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
