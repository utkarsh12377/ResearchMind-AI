# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Auth ---
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Postgres ---
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=researchmind
POSTGRES_DB=researchmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://researchmind:researchmind@localhost:5432/researchmind

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run ingestion inline instead of dispatching to a worker (local dev without Celery).
CELERY_TASK_ALWAYS_EAGER=false

# --- Storage ---
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=104857600

# --- Document understanding ---
# OCR needs the Tesseract binary + TESSDATA_PREFIX; when absent, scanned
# pages are skipped with a warning rather than failing ingestion.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
EXTRACT_TABLES=true
EXTRACT_FIGURES=true

# --- Vector stores (used from Milestone 12 onward) ---
VECTOR_STORE_BACKEND=faiss
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Knowledge graph (used from Milestone 26 onward) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Retrieval ---
# memory | faiss | qdrant
VECTOR_STORE_BACKEND=memory
QDRANT_COLLECTION=researchmind_chunks
# cross-encoder | lexical | none  (cross-encoder needs sentence-transformers)
RERANKER_BACKEND=lexical
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_DEFAULT_LIMIT=10

# --- Web search (optional; external content is treated as untrusted) ---
# Off unless a provider and key are set. External content is optional
# enrichment and is never required for a run to complete.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=

# --- LLM providers (used from Milestone 17 onward) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# openai | anthropic | gemini | echo  ("echo" is offline, for development)
DEFAULT_LLM_PROVIDER=echo
FALLBACK_LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- Embeddings ---
# openai | jina | bge | hash  ("hash" is offline and deterministic)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
JINA_API_KEY=

# --- Knowledge graph (used from Milestone 26 onward) ---
# memory | neo4j  ("memory" persists to JSON and needs no container, but is the
# one backend that cannot execute generated Cypher)
GRAPH_STORE_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# The one ingest stage that costs a model call per paper.
GRAPH_EXTRACTION_ENABLED=true
GRAPH_MAX_QUERY_LIMIT=100

# --- Evaluation (used from Milestone 34 onward) ---
# Gate thresholds for the CI benchmark.
EVAL_MIN_FAITHFULNESS=0.6
EVAL_MIN_CONTEXT_PRECISION=0.3

# --- Observability (used from Milestone 35 onward) ---
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Request hardening ---
SECURITY_HEADERS_ENABLED=true
# Refused on Content-Length before the body is buffered, so this sits above
# MAX_UPLOAD_BYTES rather than replacing it.
MAX_REQUEST_BODY_BYTES=134217728

# --- Grafana (observability compose profile) ---
GRAFANA_PASSWORD=admin

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
